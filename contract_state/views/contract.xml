<odoo>
    <record id="contract_contract_form_view" model="ir.ui.view">
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_activate"
                    type="object"
                    string="Activate"
                    class="oe_highlight"
                    invisible="state == 'active'"
                />
                <button
                    name="action_draft"
                    type="object"
                    string="Set to Draft"
                    invisible="state == 'draft'"
                />
                <button
                    name="action_cancel"
                    type="object"
                    string="Cancel"
                    invisible="state == 'cancel'"
                />
                <field
                    name="state"
                    widget="statusbar"
                    statusbar_visible="draft,active"
                />
            </header>
        </field>
    </record>

    <record id="contract_contract_tree_view" model="ir.ui.view">
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_tree_view" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="state" widget="badge" optional="show" />
            </field>
        </field>
    </record>

    <record id="contract_contract_search_view" model="ir.ui.view">
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_search_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('state', '=', 'active')]"
                />
                <separator />
            </field>
        </field>
    </record>
</odoo>
